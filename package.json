{
  "name": "clipiq",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=5757 --host=0.0.0.0",
    "electron:dev": "node scripts/clean-electron-ts-js.cjs && node scripts/build-daemon.cjs && concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5757 && VITE_DEV_SERVER_URL=http://127.0.0.1:5757 electron .\"",
    "build": "vite build && node scripts/build-electron.cjs",
    "electron:preview": "npm run build && electron .",
    "preview": "vite preview",
    "clean": "rm -rf dist release && node scripts/clean-electron-ts-js.cjs",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && node scripts/build-daemon.cjs && electron-builder",
    "dist:mac": "npm run build && node scripts/build-daemon.cjs --mac && electron-builder --mac",
    "dist:win": "npm run build && node scripts/build-daemon.cjs --win && electron-builder --win",
    "dist:extension": "node scripts/pack-extension.cjs"
  },
  "build": {
    "appId": "com.clipiq.app",
    "productName": "ClipIQ",
    "copyright": "Copyright © 2026 ClipIQ",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "src/electron-api.d.ts",
      "package.json",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/**"
    ],
    "afterPack": "scripts/after-pack-prune.cjs",
    "extraResources": [
      {
        "from": "build/daemon/${os}-${arch}/",
        "to": "daemon",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/DouYin_Spider/",
        "to": "vendor/DouYin_Spider",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!.env",
          "!outputs/**"
        ]
      },
      {
        "from": "electron/douyin_spider_runner.py",
        "to": "electron/douyin_spider_runner.py"
      }
    ],
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**",
      "node_modules/ffprobe-static/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "electron-store": "^8.2.0",
    "ffprobe-static": "^3.1.0",
    "opencc-js": "^1.3.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@radix-ui/react-select": "^2.2.6",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.100.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "electron": "^42.0.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-photo-view": "^1.2.7",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^2.1.9",
    "wait-on": "^9.0.10",
    "zustand": "^5.0.14"
  }
}
